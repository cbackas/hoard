# Required: 32 random bytes each, base64-encoded; generate each with `openssl rand -base64 32`.
# Changing either signs everyone out.
# Signs session cookies.
SESSION_SECRET=
# Encrypts Plex tokens in the database.
ENCRYPTION_KEY=

# The rest are optional — defaults shown.

# Port the web server listens on.
PORT=3000

# SIMKL app client ID. Not enforced by SIMKL yet; sent with requests when set.
SIMKL_CLIENT_ID=

# Public URL of this app, used for the Plex sign-in redirect (e.g. behind a reverse proxy).
# Derived from the request's Host header when unset. Origin only, no path: Hoard must be served from the root.
APP_URL=

# SQLite database file.
DB_PATH=./data/hoard.db
