# All optional — defaults shown.

# Port the web server listens on.
PORT=3000

# SIMKL app client ID. Not enforced by SIMKL yet; sent with requests when set.
SIMKL_CLIENT_ID=

# Plex server URL, e.g. http://192.168.1.10:32400. Skips server discovery when set.
PLEX_URL=

# Public URL of this app, used for the Plex sign-in redirect (e.g. behind a reverse proxy).
# Derived from the request's Host header when unset.
APP_URL=

# SQLite database file.
DB_PATH=./data/hoard.db
